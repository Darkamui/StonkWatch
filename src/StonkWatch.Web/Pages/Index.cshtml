@page
@model IndexModel
@{
    ViewData["Title"] = "Board";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <h1 class="h3 mb-0">Board</h1>
    @if (Model.LastPriceCheck is { } run)
    {
        var dotClass = run.Status == "Failed" ? "is-failed" : run.SkipReason is not null ? "is-idle" : "is-live";
        <div class="session-strip" title="@(run.Error ?? run.SkipReason ?? "")">
            <span class="session-dot @dotClass"></span>
            PRICE CHECK &middot; @run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            @if (run.Status == "Failed")
            {
                <text>&middot; FAILED</text>
            }
            else if (run.SkipReason is not null)
            {
                <text>&middot; IDLE</text>
            }
            else
            {
                <text>&middot; @run.CandidatesChecked CHECKED</text>
            }
        </div>
    }
    else
    {
        <div class="session-strip">
            <span class="session-dot"></span>
            PRICE CHECK HAS NEVER RUN
        </div>
    }
</div>

<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    @foreach (var status in Enum.GetNames<CandidateStatus>())
    {
        <div class="col">
            <a class="text-decoration-none" asp-page="/Candidates/Index" asp-route-status="@status">
                <div class="board-tile h-100">
                    <div class="board-tile-label">@status</div>
                    <div class="board-tile-count">@Model.StatusCounts[status]</div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Needs review</span>
                <span class="text-muted" style="text-transform:none; letter-spacing:0;">not reviewed in @IndexModel.StaleThreshold.Days+ days</span>
            </div>
            @if (Model.StaleCandidates.Count == 0)
            {
                <div class="card-body text-muted">Nothing due for review.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Last Reviewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.StaleCandidates)
                        {
                            <tr>
                                <td><a asp-page="/Candidates/Detail" asp-route-ticker="@c.Ticker">@c.Ticker</a></td>
                                <td><span class="badge text-bg-secondary badge-status">@c.Status</span></td>
                                <td>@c.Priority</td>
                                <td>@(c.LastReviewed?.ToString("yyyy-MM-dd") ?? "never")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Triggered alerts</div>
            @if (Model.TriggeredAlerts.Count == 0)
            {
                <div class="card-body text-muted">No triggered alerts.</div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ticker</th>
                            <th>Type</th>
                            <th>At</th>
                            <th>When</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.TriggeredAlerts)
                        {
                            var isBearish = a.AlertType is "Invalidation" or "PrimarySupport" or "SecondarySupport";
                            var rowClass = isBearish ? "table-danger" : "table-success";
                            <tr class="@rowClass">
                                <td><a asp-page="/Candidates/Detail" asp-route-ticker="@a.Ticker">@a.Ticker</a></td>
                                <td>
                                    @a.AlertType
                                    @if (a.AutoGenerated)
                                    {
                                        <span class="badge text-bg-light text-muted">auto</span>
                                    }
                                </td>
                                <td>@(a.TriggerPrice?.ToString("0.00##") ?? "—")</td>
                                <td>
                                    @if (a.TriggeredAt is { } at)
                                    {
                                        @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">@a.ConditionSignal</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
