@page
@model StonkWatch.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
}

<div>
    <div class="login-brand">
        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <line x1="5" y1="1" x2="5" y2="17" stroke="var(--bear)" stroke-width="1.4" />
            <rect x="3" y="6" width="4" height="7" rx="0.5" fill="var(--bear)" />
            <line x1="13" y1="1" x2="13" y2="17" stroke="var(--bull)" stroke-width="1.4" />
            <rect x="11" y="3" width="4" height="6" rx="0.5" fill="var(--bull)" />
        </svg>
        StonkWatch
    </div>
    <div class="login-card">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit" class="btn btn-google w-100">
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.87-3.04.87-2.34 0-4.32-1.58-5.03-3.7H.95v2.33A9 9 0 0 0 9 18z" />
                    <path fill="#FBBC05" d="M3.97 10.73A5.4 5.4 0 0 1 3.68 9c0-.6.1-1.19.29-1.73V4.94H.95A9 9 0 0 0 0 9c0 1.45.35 2.83.95 4.06z" />
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .95 4.94l3.02 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
                </svg>
                Sign in with Google
            </button>
        </form>
    </div>
</div>
