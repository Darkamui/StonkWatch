<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StonkWatch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StonkWatch.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        string NavClass(string prefix) => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <svg class="brand-mark" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <line x1="5" y1="1" x2="5" y2="17" stroke="var(--bear)" stroke-width="1.4" />
                        <rect x="3" y="6" width="4" height="7" rx="0.5" fill="var(--bear)" />
                        <line x1="13" y1="1" x2="13" y2="17" stroke="var(--bull)" stroke-width="1.4" />
                        <rect x="11" y="3" width="4" height="6" rx="0.5" fill="var(--bull)" />
                    </svg>
                    StonkWatch
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@(currentPath == "/" ? "nav-link active" : "nav-link")" asp-page="/Index">Board</a>
                        </li>
                        <li class="nav-item">
                            <a class="@(currentPath.StartsWith("/Candidates", StringComparison.OrdinalIgnoreCase) && !currentPath.StartsWith("/Candidates/New", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link")" asp-page="/Candidates/Index">Watchlist</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("/Candidates/New")" asp-page="/Candidates/New">Add candidate</a>
                        </li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Account/Logout" class="d-flex align-items-center gap-2 mb-0">
                            <span class="text-muted small">@User.Identity!.Name</span>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Flash"] is string flash && !string.IsNullOrEmpty(flash))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
