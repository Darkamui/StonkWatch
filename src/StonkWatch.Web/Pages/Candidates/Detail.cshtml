@page "{ticker}"
@using System.Globalization
@model StonkWatch.Web.Pages.Candidates.DetailModel
@{
    ViewData["Title"] = Model.Ticker;
    var alertTypes = Enum.GetNames<AlertType>();
    var thesisImpacts = new[] { "Improved", "Unchanged", "Weakened", "Invalidated" };
    var statuses = Enum.GetNames<CandidateStatus>();
    var ladder = LevelLadder.Build(Model.Detail!.Candidate);
}

<div class="ticket-header">
    <div>
        <div class="ticket-ticker">@Model.Ticker</div>
        <div class="ticket-meta">
            Created @Model.Detail!.Candidate.CreatedAt.ToString("yyyy-MM-dd") &middot;
            Updated @Model.Detail.Candidate.UpdatedAt.ToString("yyyy-MM-dd")
            @if (Model.Detail.Candidate.Company is { Length: > 0 } company)
            {
                <text>&middot; @company</text>
            }
        </div>
        @if (Model.Detail.Candidate.LastQuote is { } quote)
        {
            <div class="mt-2 d-flex align-items-baseline gap-2">
                <span class="quote-readout">@quote.ToString("0.00##")</span>
                <span class="text-muted small">
                    live quote &middot; @(Model.Detail.Candidate.QuoteAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "unknown")
                </span>
            </div>
        }
    </div>
    <form method="post" asp-page-handler="Delete" asp-route-ticker="@Model.Ticker"
          onsubmit="return confirm('Delete @Model.Ticker? This also removes its alerts and review history.');">
        <button type="submit" class="btn btn-outline-danger btn-sm">Delete candidate</button>
    </form>
</div>

@if (ladder is not null)
{
    <div class="ladder-hero">
        <div class="eyebrow mb-1">Plan range</div>
        <div class="ladder-track">
            @foreach (var t in ladder.Ticks)
            {
                <div class="ladder-tick kind-@t.Kind" style="left:@(t.Percent.ToString("0.##", CultureInfo.InvariantCulture))%" title="@t.Label @t.ValueDisplay"></div>
            }
            @if (ladder.Current is { } cur)
            {
                <div class="ladder-current" style="left:@(cur.Percent.ToString("0.##", CultureInfo.InvariantCulture))%" title="Last @cur.ValueDisplay"></div>
            }
        </div>
        <div class="ladder-legend">
            @foreach (var item in ladder.Legend)
            {
                <span class="ladder-chip"><span class="dot kind-@item.Kind"></span>@item.Label <b>@item.ValueDisplay</b></span>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-page-handler="Save" asp-route-ticker="@Model.Ticker">
    <partial name="_CandidateFormFields" for="Form" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>

<hr class="my-4" />

<h2 class="h5">Alerts</h2>
@if (Model.Detail.Alerts.Count == 0)
{
    <p class="text-muted">No alerts yet.</p>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Levels</th>
                    <th>Signal</th>
                    <th>Active</th>
                    <th>Triggered</th>
                    <th>Last checked</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Detail.Alerts)
                {
                    <tr>
                        <td>
                            @a.AlertType
                            @if (a.AutoGenerated)
                            {
                                <span class="badge text-bg-light text-muted" title="Managed by the price-check worker">auto</span>
                            }
                            @if (a.AcknowledgedAt is not null)
                            {
                                <span class="badge text-bg-light text-muted">acknowledged</span>
                            }
                        </td>
                        <td>
                            @a.LevelLow &ndash; @a.LevelHigh
                            @if (a.TriggerPrice is { } price)
                            {
                                <span class="text-muted small">(hit @price.ToString("0.00##"))</span>
                            }
                        </td>
                        <td>@a.ConditionSignal</td>
                        <td>
                            <form method="post" asp-page-handler="ToggleAlert" asp-route-ticker="@Model.Ticker" class="d-inline">
                                <input type="hidden" name="alertId" value="@a.Id" />
                                <input type="hidden" name="active" value="@(!a.Active)" />
                                <input type="hidden" name="triggered" value="@a.Triggered" />
                                <button type="submit" class="btn btn-sm @(a.Active ? "btn-success" : "btn-outline-secondary")">
                                    @(a.Active ? "Yes" : "No")
                                </button>
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ToggleAlert" asp-route-ticker="@Model.Ticker" class="d-inline">
                                <input type="hidden" name="alertId" value="@a.Id" />
                                <input type="hidden" name="active" value="@a.Active" />
                                <input type="hidden" name="triggered" value="@(!a.Triggered)" />
                                <button type="submit" class="btn btn-sm @(a.Triggered ? "btn-warning" : "btn-outline-secondary")">
                                    @(a.Triggered ? "Yes" : "No")
                                </button>
                            </form>
                        </td>
                        <td>@(a.LastChecked?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td class="text-end text-nowrap">
                            @if (a.Triggered && a.AcknowledgedAt is null)
                            {
                                <form method="post" asp-page-handler="AcknowledgeAlert" asp-route-ticker="@Model.Ticker"
                                      class="d-inline">
                                    <input type="hidden" name="alertId" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Acknowledge</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteAlert" asp-route-ticker="@Model.Ticker"
                                  class="d-inline" onsubmit="return confirm('Remove this alert?');">
                                <input type="hidden" name="alertId" value="@a.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<form method="post" asp-page-handler="AddAlert" asp-route-ticker="@Model.Ticker" class="row g-2 align-items-end">
    <div class="col-auto">
        <label asp-for="NewAlert.AlertType" class="form-label small">Type</label>
        <select asp-for="NewAlert.AlertType" class="form-select form-select-sm">
            @foreach (var t in alertTypes)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="NewAlert.LevelLow" class="form-label small">Level Low</label>
        <input asp-for="NewAlert.LevelLow" class="form-control form-control-sm" type="number" step="0.01" />
    </div>
    <div class="col-auto">
        <label asp-for="NewAlert.LevelHigh" class="form-label small">Level High</label>
        <input asp-for="NewAlert.LevelHigh" class="form-control form-control-sm" type="number" step="0.01" />
    </div>
    <div class="col-auto">
        <label asp-for="NewAlert.ConditionSignal" class="form-label small">Signal</label>
        <input asp-for="NewAlert.ConditionSignal" class="form-control form-control-sm" placeholder="Close above 60" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-primary">Add alert</button>
    </div>
</form>

<hr class="my-4" />

<h2 class="h5">Review log</h2>
@if (Model.Detail.ReviewLogs.Count == 0)
{
    <p class="text-muted">No reviews logged yet.</p>
}
else
{
    <div class="journal mb-3">
        @foreach (var r in Model.Detail.ReviewLogs)
        {
            var impactClass = r.ThesisImpact?.ToLowerInvariant() switch
            {
                "improved" => "impact-improved",
                "weakened" => "impact-weakened",
                "invalidated" => "impact-invalidated",
                _ => ""
            };
            <div class="journal-entry @impactClass">
                <div class="journal-entry-head">
                    <span class="journal-date">@r.ReviewDate.ToString("yyyy-MM-dd HH:mm")</span>
                    <span class="d-flex align-items-center gap-2">
                        @if (r.Price is { } reviewPrice)
                        {
                            <span class="journal-price">@reviewPrice.ToString("0.00##")</span>
                        }
                        @if (!string.IsNullOrEmpty(r.StatusAtReview))
                        {
                            <span class="badge text-bg-secondary">@r.StatusAtReview</span>
                        }
                        @if (!string.IsNullOrEmpty(r.ThesisImpact))
                        {
                            <span class="badge text-bg-light text-muted">@r.ThesisImpact</span>
                        }
                        @if (r.LevelsChanged)
                        {
                            <span class="badge text-bg-light text-muted">levels changed</span>
                        }
                    </span>
                </div>
                <dl class="journal-body row g-0 mb-0">
                    @if (!string.IsNullOrEmpty(r.WhatChanged))
                    {
                        <dt class="col-12">What changed</dt>
                        <dd class="col-12">@r.WhatChanged</dd>
                    }
                    @if (!string.IsNullOrEmpty(r.NextAction))
                    {
                        <dt class="col-12">Next action</dt>
                        <dd class="col-12">@r.NextAction</dd>
                    }
                    @if (!string.IsNullOrEmpty(r.Notes))
                    {
                        <dt class="col-12">Notes</dt>
                        <dd class="col-12">@r.Notes</dd>
                    }
                </dl>
            </div>
        }
    </div>
}

<form method="post" asp-page-handler="LogReview" asp-route-ticker="@Model.Ticker">
    <div class="row g-2">
        <div class="col-md-2">
            <label asp-for="ReviewInput.Price" class="form-label small">Price</label>
            <input asp-for="ReviewInput.Price" class="form-control form-control-sm" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <label asp-for="ReviewInput.StatusAtReview" class="form-label small">Status</label>
            <select asp-for="ReviewInput.StatusAtReview" class="form-select form-select-sm">
                <option value="">(unchanged)</option>
                @foreach (var s in statuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="ReviewInput.ThesisImpact" class="form-label small">Thesis Impact</label>
            <select asp-for="ReviewInput.ThesisImpact" class="form-select form-select-sm">
                <option value="">(none)</option>
                @foreach (var t in thesisImpacts)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ReviewInput.WhatChanged" class="form-label small">What changed</label>
            <input asp-for="ReviewInput.WhatChanged" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label asp-for="ReviewInput.NextAction" class="form-label small">Next action</label>
            <input asp-for="ReviewInput.NextAction" class="form-control form-control-sm" />
        </div>
        <div class="col-md-8">
            <label asp-for="ReviewInput.Notes" class="form-label small"></label>
            <input asp-for="ReviewInput.Notes" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 form-check mt-4">
            <input asp-for="ReviewInput.LevelsChanged" class="form-check-input" />
            <label asp-for="ReviewInput.LevelsChanged" class="form-check-label small">Levels changed</label>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Log review</button>
        </div>
    </div>
</form>
