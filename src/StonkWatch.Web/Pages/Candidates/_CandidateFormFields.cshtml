@model StonkWatch.Web.Pages.Candidates.CandidateFormInput
@{
    var priorities = new[] { "High", "Medium", "Low" };
    var statuses = Enum.GetNames<CandidateStatus>();
    var convictions = new[] { "A", "B", "C" };
    var dataQualities = new[] { "Complete", "Partial", "Unavailable" };
}

<div class="form-section">
<h2 class="form-section-title">Basics</h2>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Exchange" class="form-label"></label>
        <input asp-for="Exchange" class="form-control" placeholder="Nasdaq, TSX, ..." />
    </div>
    <div class="col-md-4">
        <label asp-for="Currency" class="form-label"></label>
        <input asp-for="Currency" class="form-control" placeholder="USD" />
    </div>
    <div class="col-md-4">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select">
            @foreach (var p in priorities)
            {
                <option value="@p" selected="@(p == Model.Priority)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(s == Model.Status)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Conviction" class="form-label"></label>
        <select asp-for="Conviction" class="form-select">
            <option value="">(none)</option>
            @foreach (var c in convictions)
            {
                <option value="@c" selected="@(c == Model.Conviction)">@c</option>
            }
        </select>
    </div>
</div>
</div>

<div class="form-section">
<h2 class="form-section-title">Thesis</h2>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="PreferredSetup" class="form-label">Preferred setup</label>
        <input asp-for="PreferredSetup" class="form-control" placeholder="Failed-breakdown reversal" />
    </div>
    <div class="col-md-6">
        <label asp-for="MainRisk" class="form-label">Main risk</label>
        <input asp-for="MainRisk" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Thesis" class="form-label"></label>
        <textarea asp-for="Thesis" class="form-control" rows="3"></textarea>
    </div>
</div>
</div>

<div class="form-section">
<h2 class="form-section-title">Levels</h2>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="CurrentPrice" class="form-label">Current price</label>
        <input asp-for="CurrentPrice" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="SupportLow" class="form-label">Support Low</label>
        <input asp-for="SupportLow" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="SupportHigh" class="form-label">Support High</label>
        <input asp-for="SupportHigh" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="Invalidation" class="form-label"></label>
        <input asp-for="Invalidation" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="SecondarySupportLow" class="form-label">2nd Support Low</label>
        <input asp-for="SecondarySupportLow" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="SecondarySupportHigh" class="form-label">2nd Support High</label>
        <input asp-for="SecondarySupportHigh" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="ReclaimTrigger1" class="form-label">Reclaim Trigger 1</label>
        <input asp-for="ReclaimTrigger1" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="ReclaimTrigger2" class="form-label">Reclaim Trigger 2</label>
        <input asp-for="ReclaimTrigger2" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="T1" class="form-label">Target 1</label>
        <input asp-for="T1" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-3">
        <label asp-for="T2" class="form-label">Target 2</label>
        <input asp-for="T2" class="form-control" type="number" step="0.01" />
    </div>
</div>
</div>

<div class="form-section">
<h2 class="form-section-title">Event &amp; data quality</h2>
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="NextEvent" class="form-label">Next event</label>
        <input asp-for="NextEvent" class="form-control" placeholder="Earnings, FDA decision, ..." />
    </div>
    <div class="col-md-4">
        <label asp-for="EventDate" class="form-label">Event date</label>
        <input asp-for="EventDate" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="DataQuality" class="form-label">Data quality</label>
        <select asp-for="DataQuality" class="form-select">
            @foreach (var q in dataQualities)
            {
                <option value="@q" selected="@(q == Model.DataQuality)">@q</option>
            }
        </select>
    </div>
    <div class="col-12">
        <label asp-for="SourceNotes" class="form-label">Source notes</label>
        <textarea asp-for="SourceNotes" class="form-control" rows="2"></textarea>
    </div>
</div>
</div>
