@page
@model StonkWatch.Web.Pages.Candidates.NewModel
@{
    ViewData["Title"] = "Add candidate";
    var placeholder = """
    {
      "ticker": "INTU",
      "company": "Intuit Inc.",
      "exchange": "Nasdaq",
      "currency": "USD",
      "priority": "High",
      "status": "Watch",
      "conviction": "B",
      "dataQuality": "Partial",
      "setup": "Post-earnings support/reclaim continuation",
      "thesis": "...",
      "mainRisk": "...",
      "sourceNotes": "...",
      "currentPrice": 369.92,
      "supportLow": 358.00,
      "supportHigh": 362.50,
      "secondarySupportLow": 343.00,
      "secondarySupportHigh": 350.50,
      "reclaimTrigger1": 371.70,
      "reclaimTrigger2": 383.30,
      "invalidation": 331.50,
      "t1": 400.00,
      "t2": 418.00,
      "nextEvent": "Earnings",
      "eventDate": "2026-08-25"
    }
    """;
}

<h1 class="h3 mb-3">Add candidate</h1>
<p class="text-muted mb-4" style="max-width: 40rem;">
    Paste a candidate as JSON. Only <code>ticker</code> is required &mdash; everything else can
    be filled in later, and any field you omit is left blank.
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <textarea asp-for="Json" class="form-control font-monospace" rows="24" placeholder="@placeholder" style="max-width: 48rem;"></textarea>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Add candidate</button>
        <a class="btn btn-outline-secondary" asp-page="/Candidates/Index">Cancel</a>
    </div>
</form>
