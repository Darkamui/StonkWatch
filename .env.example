# Copy to .env and fill in real values. Never commit .env.

# Full Npgsql connection string to the existing Postgres instance on the VPS.
STONKWATCH_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=stonkwatch;Username=stonkwatch;Password=changeme

# Razor UI login (single user, Google OAuth). Create the OAuth client in Google Cloud
# Console and register https://<host>/signin-google as an authorized redirect URI.
# Only the address in STONKWATCH_AUTH_ALLOWED_EMAIL is permitted to sign in.
STONKWATCH_AUTH_GOOGLE_CLIENT_ID=changeme
STONKWATCH_AUTH_GOOGLE_CLIENT_SECRET=changeme
STONKWATCH_AUTH_ALLOWED_EMAIL=changeme@gmail.com

# Shared secret the MCP server / API clients send as the X-Api-Key header.
STONKWATCH_API_KEY=changeme

# --- Price monitoring (optional) ---------------------------------------------
# Leave STONKWATCH_MONITORING_ENABLED unset or false and none of the rest is read.

STONKWATCH_MONITORING_ENABLED=false
STONKWATCH_MONITORING_INTERVAL_MINUTES=15

# Twelve Data API key. Required when monitoring is enabled.
STONKWATCH_MARKETDATA_APIKEY=changeme

# Where alert digests are sent from and to. A Gmail app password works as the SMTP password.
STONKWATCH_SMTP_HOST=smtp.gmail.com
STONKWATCH_SMTP_PORT=587
STONKWATCH_SMTP_USERNAME=changeme
STONKWATCH_SMTP_PASSWORD=changeme
STONKWATCH_SMTP_FROM=changeme@example.com
STONKWATCH_SMTP_TO=changeme@example.com

# External base URL, used for the links inside alert emails.
STONKWATCH_PUBLIC_BASE_URL=https://stonks.example.com
